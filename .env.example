# =============================================================================
# SalaViva — variáveis de ambiente.
#
# Copie para `.env` e ajuste o que precisar:   cp .env.example .env
#
# Toda a configuração do nó entra por aqui. Nenhum trecho de código pergunta
# "estou na AWS?": a diferença entre o notebook, o Compose e a EC2 é sempre
# injetada, nunca detectada (ver src/salaviva/config.py). É o que garante que o
# mesmo artefato ensaiado localmente é o que roda na nuvem.
#
# Prefixo obrigatório: SALAVIVA_ (as variáveis AWS_* são do próprio SDK).
# Os valores abaixo são os PADRÕES do código — descomente só o que mudar.
#
# ATENÇÃO: `.env` está no .gitignore e não entra na imagem Docker
# (ver .dockerignore). Segredo de verdade nunca deve ser versionado.
# =============================================================================


# -----------------------------------------------------------------------------
# IDENTIDADE DO NÓ
# -----------------------------------------------------------------------------

# Identificador do processo no cluster. Aparece no envelope de cada mensagem, no
# relógio vetorial, no painel /dashboard e nos logs — é o que permite dizer
# "esta mensagem nasceu naquele nó" e correlacionar o que sumiu do painel com a
# instância derrubada na demonstração de falha.
# Padrão: o hostname (nome do serviço no Compose; ID da instância na EC2).
#SALAVIVA_NODE_ID=node-a

# Rótulo do ambiente, só para log e diagnóstico: local | compose | aws
#SALAVIVA_ENVIRONMENT=local


# -----------------------------------------------------------------------------
# SERVIDOR HTTP / WEBSOCKET
# -----------------------------------------------------------------------------

# Interface de escuta. 0.0.0.0 é intencional: o container precisa aceitar o
# tráfego vindo do ALB/nginx. A porta não é alcançável da internet — o Security
# Group só libera a 8000 para o SG do balanceador (ADR-006).
#SALAVIVA_HOST=0.0.0.0

# Porta da aplicação. Mudar aqui exige mudar o target group do ALB e o
# health check do Compose.
#SALAVIVA_PORT=8000


# -----------------------------------------------------------------------------
# REDIS — comunicação indireta, ordem total e presença
# -----------------------------------------------------------------------------

# Endereço do Redis. É o componente que faz o sistema ser distribuído:
#   PUB/SUB chat:room:{id}    fan-out entre nós (nenhum nó conhece outro nó)
#   INCR    chat:seq:{id}     sequenciador de ordem total por sala
#   ZSET    chat:presence:{id} presença
#   ZSET    chat:nodes        registro de nós vivos (alimenta o /dashboard)
#
#   Compose ....... redis://redis:6379/0
#   Local direto .. redis://localhost:6379/0
#   AWS ........... redis://<endpoint-do-elasticache>:6379/0
#
# VALOR ESPECIAL: `memory://` liga o modo standalone — adaptadores em memória,
# sem Redis e sem AWS. Um nó só, mas o chat funciona por completo. É o plano B
# da apresentação caso a rede falhe (ver `make standalone`).
#SALAVIVA_REDIS_URL=redis://localhost:6379/0

# Teto do backoff de reconexão ao Redis, em segundos. Com jitter, evita que os N
# nós reconectem em sincronia após uma partição e derrubem o Redis justamente na
# recuperação (thundering herd).
#SALAVIVA_REDIS_MAX_BACKOFF=30.0


# -----------------------------------------------------------------------------
# DYNAMODB — histórico durável e replay de reconexão
# -----------------------------------------------------------------------------

# Região dos serviços AWS.
#SALAVIVA_AWS_REGION=us-east-1

# Endpoint alternativo do DynamoDB. Preenchido apenas para apontar ao DynamoDB
# Local; vazio (padrão) usa o serviço real da AWS.
#   Compose ....... http://dynamodb:8000
#   Host local .... http://localhost:8009
#SALAVIVA_DYNAMO_ENDPOINT_URL=

# Tabela do histórico. Chave: room_id (PK) + seq (SK) — o replay de reconexão é
# uma única Query com `seq > :last`, já em ordem.
#SALAVIVA_MESSAGES_TABLE=salaviva_messages

# Tabela de metadados de salas.
#SALAVIVA_ROOMS_TABLE=salaviva_rooms

# Expiração automática das mensagens (atributo TTL do DynamoDB), em dias.
# Contém o custo de armazenamento sem exigir limpeza manual.
#SALAVIVA_MESSAGE_TTL_DAYS=7

# Liga/desliga a persistência. Com `false`, o chat funciona integralmente em
# tempo real e apenas o replay de histórico fica indisponível (ADR-008: a
# persistência está fora do caminho crítico de entrega). Use `false` para rodar
# sem nenhuma credencial AWS.
#SALAVIVA_PERSISTENCE_ENABLED=true


# -----------------------------------------------------------------------------
# AUTENTICAÇÃO (JWT)
# -----------------------------------------------------------------------------

# Segredo de assinatura HS256. O token é stateless: qualquer nó do Auto Scaling
# valida a assinatura sozinho, sem consultar estado compartilhado — é essa
# propriedade que faz autenticação funcionar em cluster elástico.
#
# TODOS OS NÓS PRECISAM DO MESMO SEGREDO. Se um nó tiver outro valor, o cliente
# que reconectar nele será rejeitado com 4401 e o sintoma parecerá "instabilidade
# do cluster".
#
# Na AWS o valor vem do SSM Parameter Store (SecureString), lido no boot pelo
# instance profile — nunca do user_data e nunca da imagem.
#SALAVIVA_JWT_SECRET=dev-secret-trocar-em-producao

#SALAVIVA_JWT_ALGORITHM=HS256

# Validade do token, em horas.
#SALAVIVA_JWT_TTL_HOURS=12


# -----------------------------------------------------------------------------
# LIMITES E TEMPORIZAÇÕES
# -----------------------------------------------------------------------------

# Tamanho máximo do conteúdo de uma mensagem, em caracteres.
#SALAVIVA_MAX_CONTENT_LENGTH=4096

# Token bucket por sessão: taxa sustentada e rajada tolerada. Impede que um
# cliente abusivo degrade o serviço dos demais (e que o teste de carga vire,
# sem querer, uma negação de serviço).
#SALAVIVA_RATE_LIMIT_PER_SECOND=20.0
#SALAVIVA_RATE_LIMIT_BURST=40

# Intervalo do ping do servidor ao cliente, em segundos. Precisa ficar bem
# abaixo do idle timeout do ALB e do proxy_read_timeout do nginx (3600 s), senão
# a conexão ociosa é cortada pelo intermediário.
#SALAVIVA_HEARTBEAT_INTERVAL=20

# Idade máxima de um heartbeat antes de o membro ser varrido da presença.
# É esta janela que define em quanto tempo um nó morto some do /api/nodes — o
# marco T1 medido por scripts/kill_node.sh.
#SALAVIVA_PRESENCE_TTL=15

# Período das varreduras de presença e do heartbeat do nó, em segundos.
#SALAVIVA_SWEEPER_INTERVAL=5
#SALAVIVA_NODE_HEARTBEAT_INTERVAL=5

# Máximo de mensagens devolvidas no replay de reconexão (a partir do last_seq).
#SALAVIVA_BACKLOG_LIMIT=200

# Janela de idempotência do client_msg_id, em segundos: reenvio dentro dela não
# duplica a mensagem na sala.
#SALAVIVA_IDEMPOTENCY_TTL=300


# -----------------------------------------------------------------------------
# OBSERVABILIDADE
# -----------------------------------------------------------------------------

# Nível de log: debug | info | warning | error
#SALAVIVA_LOG_LEVEL=info

# Log em JSON (true) ou legível em terminal (false).
# Use `true` na AWS — o CloudWatch Logs Insights consulta campos estruturados.
# Use `false` no Compose — durante a demo o log é projetado e precisa ser lido.
#SALAVIVA_LOG_JSON=true


# -----------------------------------------------------------------------------
# CREDENCIAIS AWS (usadas pelo SDK, sem o prefixo SALAVIVA_)
# -----------------------------------------------------------------------------

# No Compose com DynamoDB Local qualquer valor serve — o DynamoDB Local não
# valida credenciais, mas o botocore recusa-se a assinar requisição sem elas.
#AWS_ACCESS_KEY_ID=local
#AWS_SECRET_ACCESS_KEY=local
#AWS_DEFAULT_REGION=us-east-1

# Na EC2, NÃO defina nada disso: as credenciais vêm do instance profile via
# IMDS, são temporárias e rotacionadas sozinhas. Chave estática em instância é
# exatamente o que o instance profile existe para eliminar.


# -----------------------------------------------------------------------------
# OPERAÇÃO (lidas pelos scripts em scripts/, não pela aplicação)
# -----------------------------------------------------------------------------

# URL do balanceador usada por kill_node.sh, watch_cluster.sh e deploy.sh.
#SALAVIVA_LB_URL=http://localhost:8080

# Nome do Auto Scaling Group. Se ausente, os scripts o descobrem procurando por
# 'salaviva' em `aws autoscaling describe-auto-scaling-groups`.
#SALAVIVA_ASG_NAME=

# URI do repositório ECR. Se ausente, é lido dos outputs do Terraform ou
# descoberto via `aws ecr describe-repositories`.
#SALAVIVA_ECR_REPO=
