# ---------------------------------------------------------------------------
# terraform.tfvars.example — modelo de configuração
#
# Copie para terraform.tfvars e ajuste:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# ATENÇÃO: terraform.tfvars contém o segredo JWT em texto claro. Ele NÃO deve
# ser versionado — confira se o .gitignore do projeto cobre `*.tfvars`.
# Só `terraform.tfvars.example` (este arquivo, sem segredo real) vai para o Git.
# ---------------------------------------------------------------------------

# --- Obrigatório -----------------------------------------------------------

# Segredo de assinatura dos JWT (HS256). Gere o seu com:
#
#   openssl rand -hex 32
#
# Sem espaços e com no mínimo 32 caracteres (validado pelo Terraform).
# O valor abaixo é um EXEMPLO — não use.
jwt_secret = "TROQUE-ME-openssl-rand-hex-32-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# --- Identificação ---------------------------------------------------------

project_name = "salaviva"
environment  = "demo"

# --- Região e AZs ----------------------------------------------------------

aws_region         = "us-east-1"
availability_zones = ["us-east-1a", "us-east-1b"]

# --- Capacidade ------------------------------------------------------------
# 3 nós desejados tornam a distribuição visível no /dashboard e permitem
# derrubar um sem cair abaixo do mínimo.

instance_type        = "t3.micro"
asg_min_size         = 2
asg_desired_capacity = 3
asg_max_size         = 4

# Reduzir para 2 nós corta ~1/3 do custo de EC2 se o ambiente precisar ficar de
# pé por vários dias antes da apresentação:
# asg_desired_capacity = 2

# --- Imagem ----------------------------------------------------------------
# Precisa existir no ECR antes de as instâncias subirem (ver README, deploy).

image_tag = "latest"

# --- Acesso administrativo (opcional) --------------------------------------
# Deixe vazio, salvo necessidade real. Nunca use 0.0.0.0/0.
#
# Descubra seu IP com: curl -s https://checkip.amazonaws.com
#
# allowed_ssh_cidr = "203.0.113.42/32"
# key_pair_name    = "meu-key-pair"

# Shell sem SSH via Session Manager. Ver comentário em variables.tf antes de
# ligar (a policy gerenciada é ampla).
# enable_ssm_session_manager = true

# --- HTTPS (opcional) ------------------------------------------------------
# Só faz sentido com domínio próprio: o ACM não emite certificado para o DNS do
# ALB. Informando o ARN, o listener 443 é criado e o cliente passa a usar WSS.
#
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx"

# --- Dados -----------------------------------------------------------------

redis_node_type      = "cache.t3.micro"
redis_engine_version = "7.1"
messages_table_name  = "salaviva_messages"
rooms_table_name     = "salaviva_rooms"

# `false` mantém o chat em tempo real e desliga só o replay de histórico —
# plano B se o DynamoDB der problema no dia (ADR-008).
persistence_enabled = true

# --- Observabilidade -------------------------------------------------------

log_level          = "info"
log_retention_days = 7
